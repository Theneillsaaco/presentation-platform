---
import type { SlideAnimation, SlideType } from "@/lib/content/types";

interface Props {
    type: SlideType;
    animation?: SlideAnimation;
}

const { type, animation = "fade" } = Astro.props;
---

<!--
  Pure markup, zero JS. The entrance animation is driven by
  lib/animations/runtime.ts (called from lib/reveal/init.ts) via data-animation,
  so it plays when the slide becomes current, not at page load.
-->
<div class={`slide-frame slide-frame--${type}`} data-animation={animation}>
    <div class="slide-prose" data-slide-content>
        <slot />
    </div>
</div>
