---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PresentationLayout from "@/layouts/PresentationLayout.astro";
import SlideSection, { type ResolvedSlide } from "@/components/SlideSection.astro";
import DeckHud from "@/components/ui/DeckHud.svelte";
import { listDeckSlugs, loadDeckStructure, slideContentId, assetUrl } from "@/lib/content/decks";
import type { SlideStructure } from "@/lib/content/types";

export function getStaticPaths() {
    return listDeckSlugs().map(slug => ({
        params: { deck: slug },
        props: { deck: loadDeckStructure(slug) }
    }));
}

const { deck } = Astro.props;

const allContent = await getCollection("slideContent");
const contentById = new Map<string, CollectionEntry<"slideContent">>(
    allContent.map((entry: CollectionEntry<"slideContent">) => [entry.id, entry])
);

async function resolveSlide(slide: SlideStructure): Promise<ResolvedSlide> {
    if (slide.stack?.length) {
        const children = await Promise.all(slide.stack.map(resolveSlide));
        return { ...slide, children };
    }

    const id = slideContentId(deck.slug, slide.id);
    const entry = contentById.get(id);

    if (!entry) {
        throw new Error(
            `Slide content not found: "${slide.id}" in deck "${deck.slug}".` +
            `Create src/content/${deck.slug}/slides/${slide.id}.md (or mdx)`
        );
    }

    const { Content } = await render(entry);

    return {
        ...slide,
        Content,
        backgroundImageUrl: slide.background?.image
            ? assetUrl(deck.slug, slide.background.image)
            : undefined,
        backgroundVideoUrl: slide.background?.video
            ? assetUrl(deck.slug, slide.background.video)
            : undefined,
    };
}   

const renderedSlides = await Promise.all(deck.slides.map(resolveSlide));
---

<PresentationLayout title={deck.title}>
    <div
        class="reveal"
        data-deck-slug={deck.slug}
        data-transition={deck.transition}
        data-loop={deck.loop ? "true" : undefined}
        data-theme={deck.theme}
    >
        <div class="slides">
            {renderedSlides.map(slide => <SlideSection slide={slide} />)}
        </div>
    </div>

    <DeckHud client:load />
    
    <script>
        import { initReveal } from "@/lib/reveal/init";

        const el = document.querySelector<HTMLElement>(".reveal[data-deck-slug]");
        if (el) {
            initReveal({
                deckSlug: el.dataset.deckSlug!,
                transition: el.dataset.transition as Parameters<typeof initReveal>[0]["transition"],
                loop: el.dataset.loop === "true",
            });
        }
    </script>
</PresentationLayout>
