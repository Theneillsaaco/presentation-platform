---
import "@/styles/global.css";
import { loadAllDecks } from "@/lib/content/decks";
import ThemeToggle from "@/components/ui/ThemeToggle.svelte";
import Layout from "@/layouts/Layout.astro";

const decks = loadAllDecks();
---

<Layout>
    <section class="min-h-screen bg-md-surface px-8 py-16 text-md-on-surface">
        <div class="mx-auto max-w-3xl">
            <div class="flex items-start justify-between">
                <p class="font-mono text-label-large uppercase tracking-[0.2em] text-md-primary">
                    Presentation Platform
                </p>
                <ThemeToggle client:load />
            </div>

            <h1 class="mt-3 text-display-small font-semibold">
                Tus presentaciones
            </h1>

            <p class="mt-2 text-body-large text-md-on-surface-variant">
                Cada carpeta en <code class="font-mono">src/content/</code> con un
                <code class="font-mono">slides.yaml</code> aparece aqui automáticamente.
            </p>

            <ul class="mt-10 flex flex-col gap-4">
                {decks.map((deck) => (
                    <li>
                        <a
                            href={`/${deck.slug}`}
                            class="md-state-layer flex items-center justify-between rounded-md-lg border border-md-outline-variant bg-md-surface-container-low px-6 py-4"
                        >
                            <span>
                                <span class="block text-title-medium font-medium">
                                    {deck.title}
                                </span>
                                
                                <span class="block font-mono text-label-small text-md-on-surface-variant">
                                    {deck.slides.length} slides · /{deck.slug}
                                </span>
                            </span>

                            <span class="text-md-primary" aria-hidden="true">
                                →
                            </span>
                        </a>
                    </li>
                ))}
            </ul>

            {decks.length === 0 && (
              <p class="mt-10 text-body-medium text-md-on-surface-variant">
                No decks found. Create a new deck using{" "}
                <code class="font-mono">src/content/mi-deck/slides.yaml</code> and
                reload the page.
              </p>
            )}
        </div>
    </section>
</Layout>
